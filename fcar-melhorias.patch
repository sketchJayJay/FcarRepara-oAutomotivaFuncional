+{% from '_ui.html' import icon %}<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#0b0e14"><title>Entrar · FCAR</title><link rel="stylesheet" href="{{ url_for('static',filename='utilities.css') }}"><link rel="stylesheet" href="{{ url_for('static',filename='app.css') }}"></head><body class="login-page"><main class="login-card"><img class="login-logo" src="{{ url_for('static',filename='logo.png') }}" alt="FCAR Reparação Automotiva"><h1>Bem-vindo à oficina.</h1><p>Entre para acompanhar seus atendimentos.</p>{% if error %}<div class="flash error" role="alert">{{ icon('alert') }}{{ error }}</div>{% endif %}{% with messages=get_flashed_messages(with_categories=true) %}{% for cat,msg in messages %}<div class="flash {{ 'error' if cat!='ok' else 'success' }}" role="status">{{ msg }}</div>{% endfor %}{% endwith %}<form method="post"><label>Usuário<input class="field" name="username" required autocomplete="username" autofocus value="{{ request.form.get('username','') }}"></label><label>Senha<input class="field" name="password" type="password" required autocomplete="current-password"></label><button class="btn">Entrar no sistema {{ icon('arrow') }}</button></form><div class="login-foot">FCAR · REPARAÇÃO AUTOMOTIVA</div></main></body></html>

+{% extends 'base.html' %}{% from '_ui.html' import icon %}
+{% block body %}
+<div class="page-heading"><div><p class="eyebrow">ATENDIMENTOS / {{ 'EDIÇÃO' if order else 'NOVO SERVIÇO' }}</p><h1>{{ 'Editar OS #' ~ order.id if order else 'Nova ordem de serviço' }}</h1><p class="muted">Cliente, peças e serviços. Tudo no mesmo atendimento.</p></div><a class="btn alt" href="{{ url_for('os_view',os_id=order.id) if order else url_for('os_list') }}">Voltar</a></div>
+<form method="post" id="order-form" data-editing="{{ 'true' if order else 'false' }}">
+<section class="panel form-section"><div class="section-heading"><span class="step-number">1</span><div><h2>Cliente e veículo</h2><p>Selecione o cliente e confira os dados do atendimento.</p></div></div><div class="form-grid">
+<label class="span-2">Cliente<div class="search-anchor"><input class="field" id="client-search" autocomplete="off" placeholder="Buscar nome, telefone ou documento" value="{{ selected_client.name if selected_client else '' }}" {% if order %}readonly{% else %}required role="combobox" aria-expanded="false" aria-autocomplete="list" aria-controls="client-results"{% endif %}><div class="suggestions" id="client-results" role="listbox" hidden></div></div><input type="hidden" name="client_id" id="client-id" value="{{ selected_client.id if selected_client else '' }}"><span class="help-text {{ 'selected' if selected_client }}" id="client-help">{{ 'Cliente selecionado' if selected_client else 'Escolha um cliente nos resultados da busca.' }}</span>{% if not order %} <a class="text-link" href="{{ url_for('clientes') }}#novo" target="_blank" rel="noopener">Cadastrar cliente</a>{% endif %}</label>
+<label>Data da OS<input class="field" name="os_date" type="date" required value="{{ form.get('os_date','') }}"></label>
+{% if not order %}<label class="span-full" id="vehicle-picker-label" hidden>Veículo cadastrado<select id="vehicle-picker" class="field"><option value="">Informar outro veículo</option></select></label>{% endif %}
+<input type="hidden" name="vehicle_id" id="vehicle-id" value="{{ form.get('vehicle_id','') or '' }}">
+<label>Placa <span class="muted">(opcional)</span><input class="field" name="vehicle_plate" id="vehicle-plate" maxlength="12" placeholder="ABC1D23" value="{{ form.get('vehicle_plate','') }}" style="text-transform:uppercase"></label>
+<label class="span-2">Marca / modelo <span class="muted">(opcional)</span><input class="field" name="vehicle_text" id="vehicle-model" placeholder="Ex.: Volkswagen Gol 1.0" value="{{ form.get('vehicle_text','') }}"></label>
+<label class="span-full">Mecânico responsável<select class="field" name="mechanic_id"><option value="">Selecionar depois</option>{% for m in mechs %}<option value="{{ m.id }}" {{ 'selected' if form.get('mechanic_id')|int==m.id }}>{{ m.name }}</option>{% endfor %}</select></label>
+</div></section>
+<section class="panel form-section"><div class="section-heading"><span class="step-number">2</span><div><h2>Peças e serviços</h2><p>Busque no catálogo ou adicione um item avulso.</p></div></div><div class="item-toolbar"><div class="search-anchor"><div class="search-field">{{ icon('search') }}<input type="search" id="stock-search" placeholder="Buscar uma peça ou serviço…" aria-label="Buscar peça ou serviço" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="stock-results"></div><div class="suggestions" id="stock-results" role="listbox" hidden></div></div><button type="button" class="btn alt" id="add-part">{{ icon('plus') }} Peça avulsa</button><button type="button" class="btn alt" id="add-service">{{ icon('plus') }} Serviço avulso</button></div><div class="order-items" id="order-items"></div><p class="help-text" id="items-help" aria-live="polite">Nenhum item adicionado.</p><div class="form-grid" style="margin-top:22px"><label>Mão de obra adicional (R$)<input class="field" type="number" min="0" step="0.01" inputmode="decimal" name="labor" value="{{ form.get('labor',0) }}"><span class="help-text">Use para um valor de serviço que ainda não esteja nos itens.</span></label><label class="span-2">Observações<textarea class="field" name="notes" rows="3" placeholder="Diagnóstico, orientação ao cliente ou detalhes do serviço">{{ form.get('notes','') }}</textarea></label></div><div class="order-summary"><div>Total de peças<strong id="total-parts">R$ 0,00</strong></div><div>Total de mão de obra<strong id="total-labor">R$ 0,00</strong></div><div class="grand-total">Total da OS<strong id="total-order">R$ 0,00</strong></div></div></section>
+<section class="panel form-section"><div class="section-heading"><span class="step-number">3</span><div><h2>Situação do atendimento</h2><p>Atualize o andamento e o pagamento.</p></div></div><div class="form-grid"><label>Status da OS<select class="field" name="status">{% for st in statuses %}<option {{ 'selected' if form.get('status')==st }}>{{ st }}</option>{% endfor %}</select></label><label>Forma de pagamento<select class="field" name="pay_method">{% for pm in ['Dinheiro','Pix','Cartão Débito','Cartão Crédito','Boleto','Transferência'] %}<option {{ 'selected' if form.get('pay_method')==pm }}>{{ pm }}</option>{% endfor %}</select></label><label>Pagamento<select class="field" name="pay_status">{% for ps,label in [('Pendente','A receber'),('Efetivado','Recebido'),('Cancelado','Cancelado')] %}<option value="{{ ps }}" {{ 'selected' if form.get('pay_status')==ps }}>{{ label }}</option>{% endfor %}{% if form.get('pay_status') not in ['Pendente','Efetivado','Cancelado'] %}<option selected>{{ form.get('pay_status') }}</option>{% endif %}</select></label></div><p class="help-text" style="margin-top:16px">Ao fechar a OS, as peças vinculadas saem do estoque. Reabrir ou cancelar devolve as quantidades.</p></section>
+<div class="save-bar noprint"><div><p>Total do atendimento</p><strong id="save-total">R$ 0,00</strong></div><div class="actions"><a class="btn alt" href="{{ url_for('os_view',os_id=order.id) if order else url_for('os_list') }}">Cancelar</a><button class="btn" id="save-order" type="submit">{{ icon('check') }} {{ 'Salvar alterações' if order else 'Salvar OS' }}</button></div></div>
+</form>
+<script id="initial-order-items" type="application/json">{{ items|tojson }}</script>
+<script defer src="{{ url_for('static',filename='order-form.js',v='20261110') }}"></script>
+{% endblock %}

+def pagination_for(count):
+    per_page = 25
+    pages = max(1, math.ceil(count / per_page))
+    page = bounded_int(request.args.get('page'), 1, 1, pages)
+    return dict(page=page, pages=pages, count=count, per_page=per_page, offset=(page-1)*per_page)

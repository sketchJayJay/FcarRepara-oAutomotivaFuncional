+
+@contextlib.contextmanager
+def contexts():
+    values = []
+    def record(sender, template, context, **extra):
+        values.append(context)
+    template_rendered.connect(record, module.app)
+    try:
+        yield values
+    finally:
+        template_rendered.disconnect(record, module.app)
+

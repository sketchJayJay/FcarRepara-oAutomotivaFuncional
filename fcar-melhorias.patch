+<body class="{{ 'signed-in' if username else 'public-view' }}">
+<a class="skip-link" href="#main">Ir para o conteúdo</a>
+{% if username %}
+<button class="sidebar-scrim noprint" aria-label="Fechar menu" data-menu-close hidden></button>
+<aside class="sidebar noprint" id="sidebar" aria-label="Menu principal">
+<a class="brand" href="{{ url_for('index') }}"><img src="{{ url_for('static', filename='logo.png') }}" alt="FCAR Reparação Automotiva"><span>GESTÃO DA OFICINA</span></a>
+<div class="nav-caption">PRINCIPAL</div>
+<nav>
+{% for endpoint,label,glyph,active in [
+('index','Visão geral','home',request.endpoint=='index'),
+('os_list','Ordens de serviço','orders',request.endpoint in ['os_list','os_new','os_view','os_edit']),
+('clientes','Clientes e veículos','users',request.endpoint in ['clientes','cliente_edit','veiculos']),
+('agenda','Agenda','calendar',request.endpoint=='agenda'),
+('estoque','Peças e serviços','box',request.endpoint in ['estoque','estoque_editar'])] %}
+<a class="nav-link {{ 'active' if active }}" href="{{ url_for(endpoint) }}" {% if active %}aria-current="page"{% endif %}>{{ icon(glyph) }}<span>{{ label }}</span>{% if active %}<i></i>{% endif %}</a>
+{% endfor %}
+<div class="nav-caption">CONTROLE</div>
+{% for endpoint,label,glyph,active in [
+('financeiro_dashboard','Financeiro','wallet',request.endpoint.startswith('financeiro') and request.endpoint!='financeiro_estoque'),
+('compras_list','Compras','cart',request.endpoint.startswith('compras')),
+('financeiro_estoque','Extrato de estoque','chart',request.endpoint=='financeiro_estoque'),
+('mecanicos','Mecânicos','wrench',request.endpoint.startswith('mecanico')),
+('relatorio_mecanicos','Relatório da equipe','chart',request.endpoint.startswith('relatorio'))] %}
+<a class="nav-link {{ 'active' if active }}" href="{{ url_for(endpoint) }}" {% if active %}aria-current="page"{% endif %}>{{ icon(glyph) }}<span>{{ label }}</span>{% if active %}<i></i>{% endif %}</a>
+{% endfor %}
+</nav>
+<div class="sidebar-bottom">
+<a class="nav-link" href="{{ url_for('export_backup_sql') }}">{{ icon('download') }}<span>Baixar backup</span></a>
+{% if has_acesso %}<a class="nav-link" href="{{ url_for('acesso') }}">{{ icon('qr') }}<span>Acesso por QR</span></a>{% endif %}
+<div class="user-line"><span class="avatar">{{ (username or 'A')[0]|upper }}</span><div><strong>{{ username }}</strong><small>Área administrativa</small></div><a href="{{ url_for('logout') }}" aria-label="Sair do sistema" title="Sair">{{ icon('logout') }}</a></div>
+</div></aside>
+<header class="topbar noprint"><div class="topbar-leading"><button class="icon-button mobile-menu" type="button" data-menu-toggle aria-controls="sidebar" aria-expanded="false" aria-label="Abrir menu">{{ icon('menu') }}</button><span class="topbar-label">OFICINA <span>/</span> <strong>{{ title or 'Visão geral' }}</strong></span></div><form action="{{ url_for('os_list') }}" class="topbar-search" role="search">{{ icon('search') }}<input name="q" type="search" placeholder="Buscar OS, cliente ou placa…" aria-label="Buscar OS, cliente ou placa"></form><a href="{{ url_for('os_new') }}" class="btn topbar-create">{{ icon('plus') }} Nova OS</a></header>
+{% endif %}
+<main id="main" class="app-main">
+{% with messages = get_flashed_messages(with_categories=true) %}{% if messages %}<div class="flash-stack" aria-live="polite">{% for cat,msg in messages %}<div class="flash {{ 'success' if cat=='ok' else 'error' }}" role="{{ 'status' if cat=='ok' else 'alert' }}">{{ icon('check' if cat=='ok' else 'alert') }}<span>{{ msg }}</span></div>{% endfor %}</div>{% endif %}{% endwith %}
+{% block body %}{% endblock %}
+</main>
+{% if username %}
+<nav class="bottom-nav noprint" aria-label="Atalhos no celular">
+<a href="{{ url_for('index') }}" class="{{ 'active' if request.endpoint=='index' }}">{{ icon('home') }}<span>Início</span></a>
+<a href="{{ url_for('os_list') }}" class="{{ 'active' if request.endpoint in ['os_list','os_edit','os_view'] }}">{{ icon('orders') }}<span>Ordens</span></a>
+<a class="bottom-new" href="{{ url_for('os_new') }}">{{ icon('plus') }}<span>Nova OS</span></a>
+<a href="{{ url_for('estoque') }}" class="{{ 'active' if request.endpoint=='estoque' }}">{{ icon('box') }}<span>Estoque</span></a>
+<button type="button" data-menu-toggle aria-controls="sidebar" aria-expanded="false">{{ icon('menu') }}<span>Mais</span></button>
+</nav>{% endif %}
+<dialog id="confirmModal" class="confirm-dialog noprint" aria-labelledby="confirmTitle" aria-describedby="confirmText"><div class="dialog-icon">{{ icon('trash') }}</div><h2 id="confirmTitle">Confirmar exclusão</h2><p id="confirmText">Deseja excluir este registro?</p><div class="actions"><button type="button" class="btn alt" id="btnCancel">Cancelar</button><button type="button" class="btn danger" id="btnConfirm">Excluir</button></div></dialog>
+</body></html>

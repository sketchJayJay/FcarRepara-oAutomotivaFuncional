+def date_br(value):
+    try:
+        return datetime.date.fromisoformat(str(value)[:10]).strftime("%d/%m/%Y")
+    except (ValueError, TypeError):
+        return "—"
+
+app.jinja_env.filters["datebr"] = date_br
+app.jinja_env.globals["page_url"] = page_url
 
